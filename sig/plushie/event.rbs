module Plushie
  module Event
    # Reconstruct the full scoped path from an event.
    def self.target: (untyped event) -> String

    # Remove window_id from scope tail.
    def self.strip_window_scope: (Array[String] scope, String? window_id) -> Array[String]?

    class Widget
      attr_reader type: Symbol
      attr_reader id: String
      attr_reader value: untyped
      attr_reader window_id: String?
      attr_reader scope: Array[String]

      def initialize: (
        type: Symbol,
        id: String,
        ?value: untyped,
        ?window_id: String?,
        ?scope: Array[String]
      ) -> void

      def with: (**untyped) -> Widget

      def pointer?: () -> bool
      def keyboard?: () -> bool
      def pane?: () -> bool
      def focus?: () -> bool
      def drag?: () -> bool
      def spec: () -> Hash[Symbol, untyped]?
    end

    module Specs
      NONE: Symbol
      VALUE: Symbol
      POINTER_TYPES: Set[Symbol]
      KEYBOARD_TYPES: Set[Symbol]
      PANE_TYPES: Set[Symbol]
      FOCUS_TYPES: Set[Symbol]
      DRAG_TYPES: Set[Symbol]
      BUILTIN: Hash[Symbol, Hash[Symbol, untyped]]

      def self.for: (Symbol type) -> Hash[Symbol, untyped]?
      def self.all: () -> Hash[Symbol, Hash[Symbol, untyped]]
      def self.builtin?: (Symbol type) -> bool
      def self.fields: (Symbol type) -> Array[Symbol]?
      def self.required_fields: (Symbol type) -> Array[Symbol]?
    end

    class Key
      attr_reader type: Symbol
      attr_reader key: Symbol | String
      attr_reader modified_key: (Symbol | String)?
      attr_reader physical_key: (Symbol | String)?
      attr_reader location: Symbol
      attr_reader modifiers: Hash[Symbol, bool]
      attr_reader text: String?
      attr_reader repeat: bool
      attr_reader captured: bool
      attr_reader window_id: String?

      def initialize: (type: Symbol, key: Symbol | String, ?modified_key: (Symbol | String)?, ?physical_key: (Symbol | String)?, ?location: Symbol, ?modifiers: Hash[Symbol, bool], ?text: String?, ?repeat: bool, ?captured: bool, ?window_id: String?) -> void
      def with: (**untyped) -> Key
    end

    class Ime
      attr_reader type: Symbol
      attr_reader id: String?
      attr_reader scope: Array[String]
      attr_reader text: String?
      attr_reader cursor: [Integer, Integer]?
      attr_reader captured: bool
      attr_reader window_id: String?

      def initialize: (type: Symbol, ?id: String?, ?scope: Array[String], ?text: String?, ?cursor: [Integer, Integer]?, ?captured: bool, ?window_id: String?) -> void
      def with: (**untyped) -> Ime
    end

    class Window
      attr_reader type: Symbol
      attr_reader window_id: String?
      attr_reader x: Numeric?
      attr_reader y: Numeric?
      attr_reader width: Numeric?
      attr_reader height: Numeric?
      attr_reader scale_factor: Float?
      attr_reader path: String?

      def initialize: (type: Symbol, ?window_id: String?, ?x: Numeric?, ?y: Numeric?, ?width: Numeric?, ?height: Numeric?, ?scale_factor: Float?, ?path: String?) -> void
      def with: (**untyped) -> Window
    end

    class Modifiers
      attr_reader modifiers: Hash[Symbol, bool]
      attr_reader captured: bool
      attr_reader window_id: String?

      def initialize: (modifiers: Hash[Symbol, bool], ?captured: bool, ?window_id: String?) -> void
      def with: (**untyped) -> Modifiers
    end

    class Effect
      attr_reader tag: Symbol
      attr_reader result: untyped

      def initialize: (tag: Symbol, result: untyped) -> void
      def with: (**untyped) -> Effect
    end

    # Typed per-kind result variants. Each is a Data.define class so
    # apps can pattern-match on the class with `case/in`. Matches the
    # Rust SDK's EffectResult enum.
    module Effect::Result
      FileOpened: untyped
      FilesOpened: untyped
      FileSaved: untyped
      DirectorySelected: untyped
      DirectoriesSelected: untyped
      ClipboardText: untyped
      ClipboardHtml: untyped
      ClipboardWritten: untyped
      ClipboardCleared: untyped
      NotificationShown: untyped
      Cancelled: untyped
      Timeout: untyped
      Error: untyped
      Unsupported: untyped
      RendererRestarted: untyped

      def self.decode: (String kind, String status, untyped payload) -> untyped
      def self.decode_ok: (String kind, Hash[untyped, untyped] payload) -> untyped
      def self.fetch_string: (Hash[untyped, untyped] hash, Symbol key) -> String
      def self.fetch_optional_string: (Hash[untyped, untyped] hash, Symbol key) -> String?
      def self.fetch_paths: (Hash[untyped, untyped] hash, Symbol key) -> Array[String]
    end

    class CommandError
      attr_reader reason: String
      attr_reader id: String?
      attr_reader family: String?
      attr_reader widget_type: String?
      attr_reader message: String?

      def initialize: (
        reason: String,
        ?id: String?,
        ?family: String?,
        ?widget_type: String?,
        ?message: String?
      ) -> void
      def with: (**untyped) -> CommandError
    end

    class System
      attr_reader type: Symbol
      attr_reader tag: Symbol?
      attr_reader value: untyped

      def initialize: (type: Symbol, ?tag: Symbol?, ?value: untyped) -> void
      def with: (**untyped) -> System
    end

    class Timer
      attr_reader tag: Symbol
      attr_reader timestamp: Integer

      def initialize: (tag: Symbol, timestamp: Integer) -> void
      def with: (**untyped) -> Timer
    end

    class Async
      attr_reader tag: Symbol
      attr_reader result: untyped

      def initialize: (tag: Symbol, result: untyped) -> void
      def with: (**untyped) -> Async
    end

    class Stream
      attr_reader tag: Symbol
      attr_reader value: untyped

      def initialize: (tag: Symbol, value: untyped) -> void
      def with: (**untyped) -> Stream
    end

    class SessionError
      attr_reader session: String
      attr_reader error: String

      def initialize: (session: String, error: String) -> void
      def with: (**untyped) -> SessionError
    end

    class SessionClosed
      attr_reader session: String
      attr_reader reason: String

      def initialize: (session: String, reason: String) -> void
      def with: (**untyped) -> SessionClosed
    end
  end
end
