module Plushie
  class Undo
    DEFAULT_MAX_SIZE: Integer

    class State
      attr_reader current: untyped
      attr_reader max_size: Integer
      attr_reader undo_size: Integer
      attr_reader undo_stack: Array[Entry]
      attr_reader redo_stack: Array[Entry]

      def initialize: (current: untyped, max_size: Integer, undo_size: Integer, undo_stack: Array[Entry], redo_stack: Array[Entry]) -> void

      def with: (**untyped changes) -> State
    end

    class Entry
      attr_reader apply_fn: ^(untyped) -> untyped
      attr_reader undo_fn: ^(untyped) -> untyped
      attr_reader label: String?
      attr_reader coalesce: untyped
      attr_reader timestamp: Integer

      def initialize: (apply_fn: ^(untyped) -> untyped, undo_fn: ^(untyped) -> untyped, label: String?, coalesce: untyped, timestamp: Integer) -> void

      def with: (**untyped changes) -> Entry
    end

    def self.timestamp: () -> Integer
    def self.new: (untyped model, ?max_size: Integer) -> State
    def self.push: (State u, Hash[Symbol, untyped] command) -> State
    def self.undo: (State u) -> State
    def self.redo: (State u) -> State
    def self.current: (State u) -> untyped
    def self.can_undo?: (State u) -> bool
    def self.can_redo?: (State u) -> bool
    def self.history: (State u) -> Array[String?]

    private

    def self.maybe_coalesce: (State u, Hash[Symbol, untyped] command, Integer now) -> Entry?
  end
end
