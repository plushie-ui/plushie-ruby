module Plushie
  module Package
    type renderer_manifest = {
      kind: String,
      path: String
    }

    type platform_manifest = {
      icon: String?,
      publisher: String?,
      copyright: String?,
      category: String?,
      description: String?,
      bundle_id: String?,
      macos: platform_macos_manifest?,
      windows: platform_windows_manifest?
    }

    type platform_macos_manifest = {
      bundle_version: String?
    }

    type platform_windows_manifest = {
      install_scope: String?
    }

    type manifest = {
      app_id: String,
      app_name: String?,
      app_version: String,
      target: String,
      renderer: renderer_manifest,
      platform: platform_manifest?,
      start_command: Array[String],
      working_dir: String,
      forward_env: Array[String],
      payload_archive: String,
      payload_hash: String,
      payload_size: Integer
    }

    type build_result = {
      output_dir: String,
      payload_dir: String,
      archive_path: String,
      manifest_path: String,
      payload_hash: String,
      payload_size: Integer
    }

    class PackageStartConfig < Data
      attr_reader working_dir: String
      attr_reader command: Array[String]
      attr_reader forward_env: Array[String]

      def initialize: (working_dir: String, command: Array[String], forward_env: Array[String]) -> void
    end

    class PackagePlatformMacosConfig < Data
      attr_reader bundle_version: String?

      def initialize: (bundle_version: String?) -> void
    end

    class PackagePlatformWindowsConfig < Data
      attr_reader install_scope: String?

      def initialize: (install_scope: String?) -> void
    end

    class PackagePlatformConfig < Data
      attr_reader publisher: String?
      attr_reader copyright: String?
      attr_reader category: String?
      attr_reader description: String?
      attr_reader bundle_id: String?
      attr_reader macos: PackagePlatformMacosConfig?
      attr_reader windows: PackagePlatformWindowsConfig?

      def initialize: (
        publisher: String?,
        copyright: String?,
        category: String?,
        description: String?,
        bundle_id: String?,
        macos: PackagePlatformMacosConfig?,
        windows: PackagePlatformWindowsConfig?
      ) -> void
    end

    class PackageSourceConfig < Data
      attr_reader start: PackageStartConfig
      attr_reader platform: PackagePlatformConfig?

      def initialize: (start: PackageStartConfig, platform: PackagePlatformConfig?) -> void
    end

    def self.build: (
      app_id: String,
      ?app_version: String,
      ?app_name: String?,
      ?project_dir: String,
      ?output_dir: String,
      ?target: String?,
      ?renderer_path: String?,
      ?renderer_kind: String,
      ?icon_path: String?,
      ?entrypoint: String,
      ?package_config: String?,
      ?sdk_source_path: String?,
      ?bundle_without: String,
      ?ruby_provider: String,
      ?ruby_root: String?,
      ?ruby_version: String?
    ) -> build_result

    def self.normalize_package_target: (untyped os_name, untyped arch) -> String
    def self.package_target: () -> String
    def self.sha256_file: (String path) -> String
    def self.file_size: (String path) -> Integer

    def self.manifest_for_payload: (
      app_id: String,
      app_version: String,
      renderer_path: String,
      start_command: Array[String],
      payload_archive: String,
      ?app_name: String?,
      ?target: String?,
      ?renderer_kind: String,
      ?icon_path: String?,
      ?working_dir: String,
      ?forward_env: Array[String],
      ?source_platform: PackagePlatformConfig?
    ) -> manifest

    def self.render_manifest: (manifest manifest) -> String
    def self.write_manifest: (String path, manifest manifest) -> void
    def self.default_source_config_path: (String project_dir) -> String
    def self.default_source_config: (?String entrypoint) -> PackageSourceConfig
    def self.render_source_config: (?PackageSourceConfig config) -> String
    def self.write_source_config: (String path, ?PackageSourceConfig config) -> void
    def self.load_source_config: (String path) -> PackageSourceConfig
    def self.load_default_source_config: (String project_dir) -> PackageSourceConfig?
    def self.parse_source_config: (String text) -> PackageSourceConfig
    def self.validate_source_config!: (PackageSourceConfig config) -> PackageSourceConfig
    def self.validate_start_config!: (PackageStartConfig start) -> PackageStartConfig
    def self.validate_platform_config!: (PackagePlatformConfig platform) -> PackagePlatformConfig
    def self.archive_payload!: (String payload_dir, String archive_path) -> void
    def self.validate_payload_archive_inputs!: (String payload_dir) -> void
    def self.resolve_renderer!: (?path: String?, ?kind: String) -> Hash[Symbol, String]
    def self.run_cli: (Array[String] argv) -> void
    def self.portable_package_command: (String manifest_path) -> Array[String]
    def self.build_from_env: () -> build_result
    def self.load_effective_source_config: (String project_dir, String? package_config) -> PackageSourceConfig?
    def self.resolve_start_config: (String project_dir, String? package_config, String entrypoint, ?String target) -> PackageStartConfig
    def self.resolve_start_config_from: (PackageSourceConfig? source_config, String entrypoint, ?String target) -> PackageStartConfig
    def self.build_manifest_platform: (String? icon_path, PackagePlatformConfig? source_platform) -> platform_manifest?
    def self.build_platform_config: (Hash[Symbol, untyped]? platform_raw, Hash[Symbol, untyped]? macos_raw, Hash[Symbol, untyped]? windows_raw) -> PackagePlatformConfig?
    def self.start_command: (String entrypoint, ?String target) -> Array[String]
    def self.windows_target?: (String target) -> bool
    def self.connect_rb_name: (String entrypoint) -> String
    def self.connect_cmd_name: (String entrypoint) -> String
  end
end
