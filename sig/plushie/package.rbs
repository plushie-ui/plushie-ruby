module Plushie
  module Package
    type build_result = {
      output_dir: String,
      payload_dir: String,
      manifest_path: String
    }

    class PackageStartConfig < Data
      attr_reader command: Array[String]

      def initialize: (command: Array[String]) -> void
    end

    def self.build: (
      app_id: String,
      ?app_version: String,
      ?app_name: String?,
      ?project_dir: String,
      ?output_dir: String,
      ?target: String?,
      ?renderer_path: String?,
      ?renderer_kind: String,
      ?entrypoint: String,
      ?package_config: String?,
      ?sdk_source_path: String?,
      ?bundle_without: String,
      ?ruby_provider: String,
      ?ruby_root: String?,
      ?ruby_version: String?
    ) -> build_result

    def self.normalize_package_target: (untyped os_name, untyped arch) -> String
    def self.package_target: () -> String

    def self.write_partial_manifest: (
      String path,
      app_id: String,
      app_version: String,
      renderer_path: String,
      start_command: Array[String],
      ?app_name: String?,
      ?target: String?,
      ?renderer_kind: String
    ) -> void

    def self.default_source_config_path: (String project_dir) -> String
    def self.default_source_config: (?String entrypoint) -> PackageStartConfig
    def self.render_source_config: (?PackageStartConfig config) -> String
    def self.write_source_config: (String path, ?PackageStartConfig config) -> void
    def self.resolve_renderer!: (?path: String?, ?kind: String) -> Hash[Symbol, String]
    def self.run_cli: (Array[String] argv) -> void
    def self.build_from_env: () -> build_result
    def self.start_command: (String entrypoint, ?String target) -> Array[String]
    def self.windows_target?: (String target) -> bool
    def self.start_host_rb_name: (String entrypoint) -> String
    def self.start_host_cmd_name: (String entrypoint) -> String
  end
end
