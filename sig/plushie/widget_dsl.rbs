module Plushie
  module Widget
    KNOWN_PROP_TYPES: Array[Symbol]
    RESERVED_PROP_NAMES: Array[Symbol]

    def self.define: (Symbol type_name, **untyped opts) ?{ () -> void } -> Class

    module CustomDSL
      VALID_KINDS: Array[Symbol]

      def widget: (Symbol type_name, **untyped opts) -> void
      def prop: (*Symbol names, ?type: Symbol?, ?doc: String?, ?default: untyped) -> void
      def positional: (Symbol name, ?default: untyped) -> void
      def children: (Symbol | Integer mode) -> void
      def default_a11y: (**untyped defaults) -> void
      def state: (Symbol name, ?default: untyped) -> void
      def cache_key: (^(Hash[Symbol, untyped], Hash[Symbol, untyped]) -> untyped fn) -> void
      def event: (Symbol name) -> void
      def command: (Symbol name, **Symbol params) -> void

      def rust_crate: (String path) -> void
      def rust_constructor: (String expr) -> void

      def native_crate: () -> String?
      def rust_constructor_expr: () -> String?
      def native?: () -> bool
      def stateful?: () -> bool

      def type_names: () -> Array[Symbol]
      def prop_names: () -> Array[Symbol]
      def widget_props: () -> Array[Hash[Symbol, untyped]]
      def widget_state_fields: () -> Array[Hash[Symbol, untyped]]
      def widget_events: () -> Array[Symbol]
      def widget_positionals: () -> Array[Hash[Symbol, untyped]]
      def container?: () -> bool
      def children_mode: () -> (Symbol | Integer | nil)
      def cache_key_fn: () -> (^(Hash[Symbol, untyped], Hash[Symbol, untyped]) -> untyped)?
      def prop_meta: () -> Hash[Symbol, Hash[Symbol, untyped]]
      def a11y_defaults: () -> Hash[Symbol, untyped]?

      def finalize!: () -> void
    end

    def self.finalize_on_new: (Class base) -> void
    def self.included: (Class base) -> void
  end
end
