module Plushie
  class Runtime
    include Commands
    include Subscriptions

    SDK_LOG_LEVELS: Hash[Symbol, Integer]
    DEFAULT_LOG_LEVEL: untyped

    @app: untyped
    @transport: Symbol | Array[untyped]
    @format: Symbol
    @daemon: bool
    @binary: String?
    @log_level: Symbol
    @log_level_explicit: bool
    @token: String?
    @dev: bool
    @dev_dirs: Array[String]?
    @event_queue: Thread::Queue
    @model: untyped
    @previous_tree: Node?
    @bridge: Bridge?
    @dev_server: DevServer?
    @running: bool
    @async_tasks: Hash[Symbol, Hash[Symbol, untyped]]
    @pending_effects: Hash[String, Thread]
    @effect_tags: Hash[Symbol, String]
    @effect_ids: Hash[String, Symbol]
    @effect_kinds: Hash[String, String]
    @pending_coalesce: Hash[Array[untyped], Event::Widget]
    @coalesce_order: Array[Array[untyped]]
    @memo_cache: Hash[untyped, untyped]
    @tracked_windows: Set[String]
    @pending_timers: Hash[untyped, Hash[Symbol, untyped]]
    @subscriptions: Hash[untyped, Hash[Symbol, untyped]]
    @subscription_keys: Array[untyped]
    @canvas_widgets: Hash[String, CanvasWidget::RegistryEntry]
    @consecutive_errors: Integer
    @consecutive_view_errors: Integer
    @widget_statuses: Hash[String, String]
    @focused_widget_id: String?
    @diagnostics: Array[Event::DiagnosticMessage]
    @diagnostics_mutex: Mutex
    @pending_runtime_events: Array[untyped]
    @pending_stub_acks: Hash[String, Thread::Queue[untyped]]
    @pending_await_async: Hash[Symbol, Thread::Queue[untyped]]
    @pending_interact: Hash[Symbol, untyped]?
    @logger: Logger
    @loop_thread: Thread?
    @runtime_thread: Thread?

    def initialize: (
      app: untyped,
      ?transport: Symbol | Array[untyped],
      ?format: Symbol,
      ?daemon: bool,
      ?binary: String?,
      ?log_level: Symbol,
      ?token: String?,
      ?dev: bool,
      ?dev_dirs: Array[String]?
    ) -> void

    def run: () -> void
    def start: () -> Runtime
    def stop: () -> void
    def register_effect_stub: (String kind, untyped response, ?timeout: Numeric) -> :ok
    def unregister_effect_stub: (String kind, ?timeout: Numeric) -> :ok
    def get_diagnostics: () -> Array[Event::DiagnosticMessage]
    def get_focused: () -> String?
    def view_error?: () -> bool
    def interact: (String action, ?untyped selector, ?Hash[Symbol, untyped] payload, ?timeout: Numeric) -> Array[untyped]
    def await_async: (Symbol tag, ?timeout: Numeric) -> :ok

    private

    # Lifecycle
    def start_dev_server: () -> void
    def initialize_app: () -> void
    def sdk_log_level: (untyped level) -> Integer
    def renderer_log_level: (untyped level) -> Symbol

    # Event loop
    def event_loop: () -> void
    def next_event_message: () -> untyped
    def pending_runtime_event_ready?: () -> bool
    def shift_pending_runtime_event: () -> untyped
    def advance_pending_runtime_events: () -> void

    # Coalescable event buffering
    COALESCABLE_TYPES: Array[Symbol]
    def coalescable_event?: (untyped event) -> bool
    def coalesce_event: (Event::Widget event) -> void
    def combine_scroll_events: (Event::Widget old, Event::Widget new_event) -> Event::Widget
    def flush_coalescables: () -> void

    # Event dispatch
    def dispatch_event: (untyped event) -> void
    def describe_diagnostic: (untyped diag) -> String
    def handle_timer_tick: (untyped tag) -> void
    def handle_interact_step: (untyped response) -> void
    def handle_interact_response: (untyped response) -> void
    def handle_interact_request: (String action, untyped selector, Hash[Symbol, untyped] payload, Thread::Queue[untyped] result_queue) -> void
    def apply_deferred_interact_side_effects: () -> void
    def apply_event: (untyped event) -> void
    def extract_interact_events: (untyped response) -> Array[untyped]

    # Rendering
    def render_and_snapshot: (?window_ops_order: :before_snapshot | :defer_window_ops) -> void
    def render_and_patch: () -> void
    def normalize_view_tree: ((Node | Array[Node] | nil) view_tree) -> Node

    # Result validation
    def unwrap_result: (untyped result) -> [untyped, Command::Cmd]

    # Async handling
    def handle_async_result: (Symbol tag, Integer nonce, untyped result) -> void
    def handle_stream_value: (Symbol tag, Integer nonce, untyped value) -> void
    def notify_await_async: (Symbol tag) -> void

    # Effect handling
    def handle_effect_timeout: (String id) -> void

    def start_bridge: () -> void
    def build_settings: () -> Hash[Symbol, untyped]
    def bridge_send_window_op: (String | Symbol op, String window_id, ?Hash[Symbol | String, untyped] settings) -> void

    # Renderer exit / restart
    def handle_renderer_exit: (untyped reason) -> void
    def handle_renderer_restarted: () -> void
    def fail_pending_interact: (String reason) -> void
    def build_renderer_exit: (untyped reason) -> untyped
    def safe_class_name: (untyped value) -> String

    # Init validation
    def validate_app!: (untyped app) -> void
    def validate_transport!: (untyped transport) -> void

    # Status-based focus tracking
    def handle_status_event: (Event::Widget event) -> void

    # Interact
    INTERACT_TIMEOUT_S: Integer
    def handle_interact_timeout: (String id) -> void
    def format_interact_target: (String action, untyped selector) -> String
    def format_interact_timeout: (String action, untyped selector) -> String
    def format_await_async_timeout: (Symbol tag) -> String

    # View errors
    VIEW_ERROR_WARN_THRESHOLD: Integer
    def inject_frozen_ui_overlay: () -> void

    # Error handling
    def handle_callback_error: (String callback_name, Exception error, ?hint: String?) -> void
    def handle_view_error: (Exception error) -> void
    def rerender_after_widget_state_change: (Hash[String, CanvasWidget::RegistryEntry] widgets_before) -> void
    def resend_last_snapshot: () -> void

    # Resync helpers
    def send_settings: () -> void
    def flush_pending_effects_on_exit: (untyped result, ?execute_returned_commands: bool execute_returned_commands) -> void
    def flush_pending_stub_acks: () -> void
    def reset_renderer_subscriptions: () -> void

    # Shutdown
    def shutdown: () -> void

    module Commands
      DISPATCH_DEPTH_LIMIT: Integer

      private

      def execute_commands: (Command::Cmd? cmd) -> void
      def execute_async: (Proc callable, Symbol tag) -> void
      def execute_stream: (Proc callable, Symbol tag) -> void
      def stop_thread: (Thread? thread, ?timeout: Numeric) -> void
      def cancel_task: (Symbol tag) -> void
      def execute_done: (untyped value, Proc mapper) -> void
      def enqueue_runtime_event: (untyped message) -> untyped
      def execute_send_after: (Integer delay_ms, untyped event) -> void
      def execute_effect: (Hash[Symbol, untyped] payload) -> void
      def send_widget_op: (Symbol op, Hash[Symbol, untyped] payload) -> void
      def send_load_font: (String family, String data) -> void
      def send_window_op: (Hash[Symbol, untyped] payload) -> void
      def send_window_query: (Hash[Symbol, untyped] payload) -> void
      def send_system_op: (Hash[Symbol, untyped] payload) -> void
      def send_system_query: (Hash[Symbol, untyped] payload) -> void
      def send_image_op: (Hash[Symbol, untyped] payload) -> void
      def send_command: (Hash[Symbol, untyped] payload) -> void
      def send_commands: (Array[Hash[Symbol, untyped]] commands) -> void
      def send_advance_frame: (Integer timestamp) -> void
    end

    module Subscriptions
      private

      def sync_subscriptions: () -> void
      def diff_subscriptions: (Hash[untyped, Subscription::Sub] new_by_key, Array[untyped] new_sorted_keys) -> void
      def start_subscription: (Subscription::Sub spec) -> Hash[Symbol, untyped]
      def stop_subscription: (untyped key) -> void
      def start_timer_subscription: (Subscription::Sub spec) -> Hash[Symbol, untyped]
      def start_renderer_subscription: (Subscription::Sub spec) -> Hash[Symbol, untyped]
      def update_max_rates: (Hash[untyped, Subscription::Sub] new_by_key) -> void
      def check_max_rate: (untyped key, Subscription::Sub spec) -> void
    end
  end
end
