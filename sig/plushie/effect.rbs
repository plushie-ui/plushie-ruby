module Plushie
  module Effect
    TIMEOUT_FILE: Integer
    TIMEOUT_CLIPBOARD: Integer
    TIMEOUT_NOTIFICATION: Integer

    # File dialogs
    def self.file_open: (Symbol tag, **untyped opts) -> Command::Cmd
    def self.file_open_multiple: (Symbol tag, **untyped opts) -> Command::Cmd
    def self.file_save: (Symbol tag, **untyped opts) -> Command::Cmd
    def self.directory_select: (Symbol tag, **untyped opts) -> Command::Cmd
    def self.directory_select_multiple: (Symbol tag, **untyped opts) -> Command::Cmd

    # Clipboard
    def self.clipboard_read: (Symbol tag) -> Command::Cmd
    def self.clipboard_write: (Symbol tag, String text) -> Command::Cmd
    def self.clipboard_read_html: (Symbol tag) -> Command::Cmd
    def self.clipboard_write_html: (Symbol tag, String html, ?alt_text: String?) -> Command::Cmd
    def self.clipboard_clear: (Symbol tag) -> Command::Cmd
    def self.clipboard_read_primary: (Symbol tag) -> Command::Cmd
    def self.clipboard_write_primary: (Symbol tag, String text) -> Command::Cmd

    # Notifications
    def self.notification: (Symbol tag, String title, String body, **untyped opts) -> Command::Cmd

    # Internals
    def self.request: (Symbol tag, Symbol kind, **untyped opts) -> Command::Cmd
    def self.default_timeout: (String | Symbol kind) -> Integer
    def self.generate_id: () -> String
  end
end
