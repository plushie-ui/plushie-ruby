module Plushie
  class Bridge
    BACKOFF_BASE_MS: Integer
    BACKOFF_MAX_MS: Integer
    MAX_RETRIES: Integer
    SDK_LOG_LEVELS: Hash[Symbol, Integer]
    DEFAULT_LOG_LEVEL: untyped

    attr_reader format: Symbol
    attr_reader hello: Hash[Symbol, untyped]?

    @event_queue: Thread::Queue
    @binary: String?
    @transport: Symbol | Array[untyped]
    @log_level: Symbol
    @token: String?
    @connection: Connection?
    @retry_count: Integer
    @settings: Hash[Symbol, untyped]
    @heartbeat_interval: Numeric?
    @heartbeat_timer: Thread?
    @forwarder_thread: Thread?
    @conn_queue: Thread::Queue?
    @logger: Logger

    def initialize: (
      event_queue: Thread::Queue,
      ?format: Symbol,
      ?binary: String?,
      ?transport: Symbol | Array[untyped],
      ?log_level: Symbol,
      ?token: String?,
      ?heartbeat_interval: Numeric?
    ) -> void

    def start: (?settings: Hash[Symbol, untyped]) -> void
    def send_encoded: (String data) -> void
    def send_register_effect_stub: (String kind, untyped response) -> void
    def send_unregister_effect_stub: (String kind) -> void
    def stop: () -> void

    private

    def connect!: () -> void
    def sdk_log_level: (untyped level) -> Integer
    def renderer_log_level: (untyped level) -> Symbol
    def start_forwarder: (Thread::Queue conn_queue) -> Thread
    def attempt_restart: () -> void
    def cancel_heartbeat_timer: () -> void
    def stop_thread: (Thread? thread, timeout: Numeric) -> void
    def handle_connect_failure: (Exception error) -> void
  end
end
